/* ==================== 登录/注册页面通用样式 ==================== */

/* 标题：大字加粗 */
loginpage QLabel#labelTitle,
registerpage QLabel#labelTitle {
    font-size: 28px;
    font-weight: bold;
    color: #1E293B;
    qproperty-alignment: AlignCenter;
    padding-top: 30px;
}

/* 副标题：灰色 */
loginpage QLabel#labelPrompt,
registerpage QLabel#labelPrompt {
    font-size: 14px;
    color: #94A3B8;
    qproperty-alignment: AlignCenter;
    padding-top: 4px;
    padding-bottom: 30px;
}

/* "用户名"/"密码" 标签 */
loginpage QLabel#labelUsername,
loginpage QLabel#labelPassword,
registerpage QLabel#labelUsername,
registerpage QLabel#labelPassword,
registerpage QLabel#labelConfirmPassword {
    font-size: 14px;
    color: #334155;
    font-weight: bold;
    padding-left: 2px;
    padding-top: 10px;
}

/* 输入框 */
loginpage QLineEdit,
registerpage QLineEdit {
    padding: 10px 14px;
    border: 1.5px solid #E2E8F0;
    border-radius: 8px;
    font-size: 14px;
    background-color: #FFFFFF;
    color: #1E293B;
}

loginpage QLineEdit:focus,
registerpage QLineEdit:focus {
    border-color: #3B82F6;
}

loginpage QLineEdit::placeholder,
registerpage QLineEdit::placeholder {
    color: #B0BEC5;
}

/* 错误提示：红色居中文字 */
loginpage QLabel#labelWarning,
registerpage QLabel#labelWarning {
    font-size: 14px;
    color: #EF4444;
    qproperty-alignment: AlignCenter;
}

/* 登录按钮：蓝色实心 */
loginpage QPushButton#btnLogin {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-size: 16px;
    font-weight: bold;
    margin-top: 30px;
}

loginpage QPushButton#btnLogin:hover {
    background-color: #2563EB;
}

loginpage QPushButton#btnLogin:pressed {
    background-color: #1D4ED8;
}

/* 注册按钮：蓝色实心 */
registerpage QPushButton#btnRegister {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-size: 16px;
    font-weight: bold;
    margin-top: 20px;
}

registerpage QPushButton#btnRegister:hover {
    background-color: #2563EB;
}

registerpage QPushButton#btnRegister:pressed {
    background-color: #1D4ED8;
}

/* 切换页面链接按钮 */
loginpage QPushButton#btnToRegister,
registerpage QPushButton#btnToLogin {
    background-color: transparent;
    color: #3B82F6;
    border: none;
    font-size: 14px;
    padding: 8px;
}

loginpage QPushButton#btnToRegister:hover,
registerpage QPushButton#btnToLogin:hover {
    color: #2563EB;
    text-decoration: underline;
}
