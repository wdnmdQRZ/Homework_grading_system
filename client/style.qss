/* ==================== 登录窗口 ==================== */
logindialog {
    background-color: #FFFFFF;
}

/* 标题：大字加粗 */
logindialog QLabel#labelTitle {
    font-size: 28px;
    font-weight: bold;
    color: #1E293B;
    qproperty-alignment: AlignCenter;
    padding-top: 30px;
}

/* 副标题：灰色 */
logindialog QLabel#labelPrompt {
    font-size: 14px;
    color: #94A3B8;
    qproperty-alignment: AlignCenter;
    padding-top: 4px;
    padding-bottom: 30px;
}

/* "用户名"/"密码" 标签 */
logindialog QLabel#labelUsername,
logindialog QLabel#labelPassword {
    font-size: 14px;
    color: #334155;
    font-weight: bold;
    padding-left: 2px;
    padding-top: 10px;
}

/* 输入框 */
logindialog QLineEdit {
    padding: 10px 14px;
    border: 1.5px solid #E2E8F0;
    border-radius: 8px;
    font-size: 14px;
    background-color: #FFFFFF;
    color: #1E293B;
}

logindialog QLineEdit:focus {
    border-color: #3B82F6;
}

logindialog QLineEdit::placeholder {
    color: #B0BEC5;
}

/* 错误提示：红色居中文字 */
logindialog QLabel#labelWarning {
    font-size: 14px;
    color: #EF4444;
    qproperty-alignment: AlignCenter;
}

/* 登录按钮：蓝色实心 */
logindialog QPushButton#btnLogin {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-size: 16px;
    font-weight: bold;
    margin-top: 30px;
}

logindialog QPushButton#btnLogin:hover {
    background-color: #2563EB;
}

logindialog QPushButton#btnLogin:pressed {
    background-color: #1D4ED8;
}

/* 注册按钮：白底蓝边 */
logindialog QPushButton#btnRegister {
    background-color: #FFFFFF;
    color: #3B82F6;
    border: 1.5px solid #3B82F6;
    border-radius: 8px;
    padding: 12px;
    font-size: 16px;
    font-weight: bold;
}

logindialog QPushButton#btnRegister:hover {
    background-color: #EFF6FF;
}

logindialog QPushButton#btnRegister:pressed {
    background-color: #DBEAFE;
}
